VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
VITE_API_BASE_URL=http://localhost:5000

# Yatra / Events module
VITE_WHATSAPP_NUMBER=918252224027
# Optional UPI ID shown on the booking payment step
VITE_UPI_ID=
# Admin URL slug — pick any word you'll remember (no slashes), keep it out of git.
# The admin area lives at /<this>/events instead of the public /admin/events.
# Real access control is still server-side (ADMIN_EMAILS) — this just keeps the
# link off the public site, so a simple word like "owner" is fine.
VITE_ADMIN_PATH=owner
