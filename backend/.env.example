MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
PORT=5000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
JWT_SECRET=your_super_secret_jwt_key
RESEND_API_KEY=re_your_resend_api_key
NODE_ENV=development
# Exact deployed frontend origin, without a trailing slash or path.
FRONTEND_URL=https://your-production-app.vercel.app

# Yatra / Events module
# Comma-separated emails that are auto-promoted to admin on login
ADMIN_EMAILS=admin@example.com
# WhatsApp number (with country code, no +) used for booking hand-off
WHATSAPP_BOOKING_NUMBER=918252224027
# Optional UPI ID shown on the booking payment step
UPI_ID=
SEAT_HOLD_MINUTES=5
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, required for server-side recovery through Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=
